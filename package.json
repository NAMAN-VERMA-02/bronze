{
  "name": "bronze",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "client": "npm run dev -w client",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client",
    "test": "tsx shared/test/bronze.test.ts",
    "build": "npm run build -w client",
    "test:e2e": "node tests/e2e-autoplay.mjs",
    "test:smoke": "node tests/e2e-smoke.mjs && node tests/e2e-table.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "playwright": "^1.56.1"
  }
}
